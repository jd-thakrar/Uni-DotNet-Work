@model  List<Practical_6.Models.ProductDetails>
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Product</title>
</head>
<body>
    <div>
        <h2>Product Details</h2>

        @foreach (var i in Model)
        {
            <img src="@i.imageUrl" width="150" height="150" />
          

            <h3>Product Name: @i.name</h3>
           

            <h4>Product Category: @i.category</h4>
          


            <h4>Product Price: @i.price</h4>


            @Html.ActionLink("Click for more details", "Details", "ProductDetails", new { id = i.id }, null)

            <hr />

        }
    </div>
</body>
</html>
